{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndexaContracts",
  "$defs": {
    "PlagiarismInput": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000
        },
        "scope": {
          "type": "string",
          "enum": ["web", "private", "both"]
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["text", "scope"]
    },
    "PlagiarismMatch": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_url": {
          "type": "string"
        },
        "source_doc_id": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["start", "end", "excerpt", "score"]
    },
    "PlagiarismOutput": {
      "type": "object",
      "properties": {
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlagiarismMatch"
          }
        },
        "engine": {
          "type": "string"
        }
      },
      "required": ["similarity", "matches", "engine"]
    },
    "PlagiarismTask": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "done", "failed"]
        },
        "progress": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "result": {
          "$ref": "#/$defs/PlagiarismOutput"
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["task_id", "status"]
    },
    "PrivateSourceInput": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400000
        }
      },
      "required": ["workspace_id", "title", "text"]
    },
    "PrivateSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["source_id", "title", "word_count"]
    }
  }
}
