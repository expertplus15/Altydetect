# Variables d'environnement d'AltyDetect.
# Copier en .env (jamais commité) et remplir. Aucune clé réelle ici, jamais.
# Les valeurs locales correspondent à docker-compose.yml.

# --- Application web (apps/web) ---
# URL publique de l'application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js (magic link e-mail + Google) ---
# Secret de chiffrement des sessions : générer avec `openssl rand -base64 32`.
AUTH_SECRET=
# Identifiants OAuth Google (console Google Cloud).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Envoi des liens de connexion par Resend (ADR-0003) : clé API et expéditeur vérifié.
AUTH_RESEND_KEY=
# TODO : adresse d'expédition sur le domaine vérifié dans Resend.
AUTH_EMAIL_FROM="AltyDetect <connexion@altydetect.com>"
# resend (défaut) | log : « log » dépose le lien dans Redis pour les tests de bout en bout.
# Interdit en production.
AUTH_EMAIL_TRANSPORT=resend

# --- PostgreSQL 16 + pgvector (Prisma) ---
DATABASE_URL=postgresql://altydetect:altydetect@localhost:5432/altydetect
# Base vide utilisée par `prisma migrate diff` pour vérifier les migrations (CI).
SHADOW_DATABASE_URL=postgresql://altydetect:altydetect@localhost:5432/altydetect_shadow

# --- Redis (BullMQ côté Node, RQ côté Python) ---
REDIS_URL=redis://localhost:6379

# --- Services internes ---
VERITAS_URL=http://localhost:8001
INDEXA_URL=http://localhost:8002
# Jeton partagé entre l'application web et Indexa (routes /internal/*). Générer :
# openssl rand -base64 32
INDEXA_INTERNAL_TOKEN=

# --- Indexa : recherche web du plagiat (ADR-0007) ---
# brave (défaut) | fixtures : « fixtures » lit un corpus local (tests, benchmark).
INDEXA_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# Requêtes de recherche et pages lues au plus par analyse.
INDEXA_MAX_QUERIES=8
INDEXA_MAX_PAGES=10
# TODO : prix de Brave pour 1 000 requêtes, utilisé par le benchmark pour le coût par document.
INDEXA_SEARCH_PRICE_PER_1000_EUR=

# --- Veritas : détection (ADR-0008) ---
# Jeton partagé entre l'application web et Veritas (routes /internal/*). Générer :
# openssl rand -base64 32
VERITAS_INTERNAL_TOKEN=
# Dossier des paquets de modèles (un sous-dossier par langue : fr/manifest.json…). Vide : Veritas
# indisponible, le fournisseur externe répond seul. Modèles livrés : services/veritas/models
# (dans l'image Docker : /app/services/veritas/models). Activation : ADR-0010.
VERITAS_MODEL_DIR=
# Couche 2 sur Modal (inférence GPU à la demande) : jeton du compte Modal (modal.com).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optionnel : dossier de thresholds.yaml et routing.yaml (défaut : services/veritas/config).
VERITAS_CONFIG_DIR=
# production interdit le fournisseur simulé.
VERITAS_ENV=development
# « 1 » autorise DETECTION_PROVIDER=simulated (développement, tests de bout en bout).
VERITAS_ALLOW_SIMULATED=

# --- Fournisseur de détection externe (services/veritas/providers/) ---
# Valeurs possibles : pangram | copyleaks | gptzero | simulated.
# TODO : fixé par ADR-0001 (proposé : pangram, repli copyleaks).
DETECTION_PROVIDER=
DETECTION_FALLBACK_PROVIDER=
PANGRAM_API_KEY=
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
GPTZERO_API_KEY=

# --- LLM (API Claude, modèle fixé dans packages/core/src/config/llm.ts) ---
ANTHROPIC_API_KEY=
# claude (défaut) | fake : « fake » remplace l'API par un flux simulé pour les tests de bout
# en bout. Interdit en production.
ALTY_LLM=claude

# --- Stripe (Checkout, Customer Portal, webhooks) ---
# Clé secrète (sk_test_… en développement). Produits et prix : pnpm stripe:seed.
STRIPE_SECRET_KEY=
# Secret de signature du point de terminaison /api/webhooks/stripe (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Identifiant affiché par pnpm stripe:seed (portail : résiliation, changement de période).
STRIPE_PORTAL_CONFIGURATION_ID=
# Optionnel : URL de retour par défaut du portail, pour stripe:seed.
STRIPE_PORTAL_RETURN_URL=

# --- Stockage S3 compatible (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Inférence GPU à la demande (Modal) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Observabilité (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Tests de bout en bout uniquement (voir apps/web/playwright.config.ts) ---
# ALTY_E2E=1 autorise, sur un build de production local, le modèle simulé (ALTY_LLM=fake),
# les e-mails déposés dans Redis (AUTH_EMAIL_TRANSPORT=log) et un Stripe simulé
# (STRIPE_API_BASE=http://localhost:12111). Ne jamais définir ces variables en production.
